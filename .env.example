# Copy to .env (never commit .env) and paste your Web3Forms access key.
# Get one free at https://web3forms.com — enter olesia.dmytrush@gmail.com and the key arrives by email.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional, only needed for local production builds: absolute site URL used in social-preview tags.
# The GitHub Pages workflow sets this automatically.
SITE_URL=
